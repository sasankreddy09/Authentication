      "gesture": "think"
     }
    },
    {
     "speaker": "meera",
     "tone": "explainer",
     "text": "Close. The projector puts both pictures on the same screen, each through a different filter.",
     "kind": "fact",
     "claims": [
      "c_f3"
     ]
