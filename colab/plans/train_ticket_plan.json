 "claims": [
  {
   "id": "c1",
   "text": "Reserved tickets can be booked up to 60 days before the journey (advance reservation period cut from 120 to 60 days from 1 November 2024).",
   "sources": [
    "https://www.businesstoday.in/india/story/new-train-ticket-booking-rules-top-reservation-related-changes-applicable-from-nov-1-452214-2024-11-01",
    "https://www.outlooktraveller.com/News/irctc-makes-changes-to-its-advance-booking-period-heres-what-you-need-to-know"
   ]
  },
  {
   "id": "c2",
   "text": "RAC passengers may board and travel in reserved coaches, sharing a berth until one is upgraded; RAC gets confirmed first, then waiting-list tickets, as booked passengers cancel.",
   "sources": [
    "https://en.wikipedia.org/wiki/Reservation_against_Cancellation",
    "https://www.ixigo.com/what-does-rac-status-mean-in-indian-railways-2-story-1183627"
   ]
  },
  {
   "id": "c3",
   "text": "Indian Railways prepares the reservation chart before departure; in 2025 the first chart moved from 4 hours to 8 hours before departure, and later earlier still for morning trains.",
   "sources": [
    "https://www.business-standard.com/india-news/indian-railways-passenger-reservation-chart-departure-booking-rules-125063000537_1.html",
    "https://www.thehitavada.com/Encyc/2025/12/27/now-railway-reservation-charts-to-be-ready-one-day-in-advance.html"
   ]
  },
  {
   "id": "c4",
   "text": "Fully waitlisted e-tickets are cancelled by Railways after chart preparation and the refund is credited automatically; those passengers are dropped from the chart and are not allowed to board.",
   "sources": [
    "https://www.icicibank.com/personal-banking/insta-banking/irctc-ticket-booking/terms-conditions",
    "https://crpf.gov.in/Upload/News/File/1730_1_2239128930_eTicket.pdf"
   ]
  },
  {
   "id": "c5",
   "text": "Passengers can travel with the e-ticket SMS or Virtual Reservation Message plus one prescribed original photo ID; only confirmed, RAC or partially confirmed e-tickets are valid for travel.",
   "sources": [
    "https://crpf.gov.in/Upload/News/File/1730_1_2239128930_eTicket.pdf"
   ]
  },
  {
   "id": "c6",
   "text": "Tatkal booking opens one day before the journey: 10:00 AM for AC classes and 11:00 AM for non-AC classes; online Tatkal needs an Aadhaar-authenticated account (from July 2025).",
   "sources": [
    "https://www.deccanherald.com/amp/story/india/explained-all-you-need-to-know-about-the-new-rules-for-tatkal-ticket-booking-3582881",
    "https://thesouthfirst.com/news/from-1-july-aadhaar-authentication-mandatory-for-tatkal-bookings-on-irctc-website-and-app"
   ]
  }
 ],
