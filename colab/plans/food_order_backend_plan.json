   "lines": [{"speaker": "narrator", "tone": "explainer", "text": "A relay reads the outbox and publishes an 'order placed' event to a message broker like Kafka. Other services simply listen."}]},

  {"shot_id": "sh07", "mood": "busy", "seed": 307, "location": "backend", "recipe": "diagram", "label": "Step 5 · Restaurant",
