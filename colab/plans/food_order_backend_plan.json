   "diagram": {"focus": ["app", "gw", "order"],
               "flows": [{"from": "app", "to": "gw", "label": "POST /orders"}, {"from": "gw", "to": "order", "label": "create order"}],
               "note": ["POST /orders", "Idempotency-Key: 9f2c-41ab", "{ items: [biryani x1], total: 349 }"]},
   "lines": [{"speaker": "narrator", "tone": "explainer", "text": "The app sends the order to an API gateway. An idempotency key makes sure a retry never creates a second order."}]},

  {"shot_id": "sh04", "mood": "busy", "seed": 304, "location": "backend", "recipe": "diagram", "label": "Step 2 · One transaction",
   "diagram": {"focus": ["order", "odb"],
               "flows": [{"from": "order", "to": "odb", "label": "BEGIN ... COMMIT"}],
               "table": {"name": "orders", "columns": ["order_id", "status", "amount"], "rows": [["48213", "-", "Rs 349"]],
                         "changes": [{"row": 0, "col": "status", "value": "CREATED"}]},
               "note": ["BEGIN;", "INSERT INTO orders (...);", "INSERT INTO order_items (...);", "INSERT INTO outbox (...);", "COMMIT;"]},
   "lines": [{"speaker": "narrator", "tone": "explainer", "text": "The order service saves the order, its items and an outbox event in one ACID transaction. All of it is saved, or none of it."}]},

  {"shot_id": "sh05", "mood": "busy", "seed": 305, "location": "backend", "recipe": "diagram", "label": "Step 3 · Payment",
   "diagram": {"focus": ["order", "pay", "pgw"],
