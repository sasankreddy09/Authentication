 "claims": [
  {"id": "c1", "text": "Transactional outbox: write the change and an outbox row in one transaction; a relay publishes the event.",
   "sources": ["https://oneuptime.com/blog/post/2026-03-31-redis-outbox-pattern/view", "https://blog.adamfurmanek.pl/2022/12/10/distributed-designs-part-1/"]},
  {"id": "c2", "text": "Idempotency keys make retried API requests safe (no duplicate orders).",
   "sources": ["https://gravitee.io/corpus/gen-1019/online-transaction-processing/idempotency-keys-and-exactly-once-semantics-for-online-transaction-processing-apis.html"]},
  {"id": "c3", "text": "Food-ordering system designs commonly use an order state machine with events on Kafka and a SQL store for transactional data.",
   "sources": ["https://github.com/Anshul619/HLD-System-Designs/blob/main/0_HLDUseCasesProblems/FoodOrderingZomatoSwiggy/Readme.md"]},
  {"id": "c4", "text": "Redis geospatial indexes answer 'members within a radius' queries (GEOSEARCH).",
   "sources": ["https://redis.io/docs/latest/commands/geosearch/"]}
 ],
