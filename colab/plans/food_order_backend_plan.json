               "table": {"name": "orders", "columns": ["order_id", "status", "amount"], "rows": [["48213", "CREATED", "Rs 349"]],
                         "changes": [{"row": 0, "col": "status", "value": "PAID", "at": 6.2}]}},
   "lines": [{"speaker": "narrator", "tone": "explainer", "text": "The payment service charges you through a payment gateway, which confirms with a webhook. Now the order is paid."}]},

  {"shot_id": "sh06", "mood": "curious", "seed": 306, "location": "backend", "recipe": "diagram", "label": "Step 4 · Events",
   "diagram": {"focus": ["odb", "bus"],
               "flows": [{"from": "odb", "to": "bus", "label": "OrderPlaced"}],
               "note": ["-- outbox relay", "SELECT * FROM outbox WHERE sent = false;", "publish -> topic order-events", "UPDATE outbox SET sent = true;"]},
