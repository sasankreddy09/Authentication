 "claims": [
  {
   "id": "c1",
   "text": "In binocular depth vision, the sensation arises from processing differences in retinal images resulting from the two eyes looking from different, but similar, directions.",
   "sources": [
    "https://en.wikipedia.org/wiki/Stereopsis"
   ],
   "source_revision": 1377837508
  },
  {
   "id": "c2",
   "text": "The distance between the lenses in a typical stereo camera is about the distance between one's eyes and is about 6.35 cm.",
   "sources": [
    "https://en.wikipedia.org/wiki/Stereo_camera"
   ],
   "source_revision": 1376169392
  },
  {
   "id": "c3",
   "text": "The two images are combined in the brain to give the perception of stereopsis; when viewed, the human brain perceives the images as a single 3D view, giving the viewer the perception of 3D depth.",
   "sources": [
    "https://en.wikipedia.org/wiki/Stereoscopy"
   ],
   "source_revision": 1380706327
  },
  {
   "id": "c4",
   "text": "To present stereoscopic images and films, two images are projected superimposed onto the same screen or displayed through different polarizing filters.",
   "sources": [
    "https://en.wikipedia.org/wiki/Polarized_3D_system"
   ],
   "source_revision": 1377586129
  },
  {
   "id": "c5",
   "text": "The viewer wears low-cost eyeglasses with a polarizing filter for each eye. The left and right filters have different polarizations, so each eye receives only the image with the matching polarization.",
   "sources": [
    "https://en.wikipedia.org/wiki/Polarized_3D_system"
   ],
   "source_revision": 1377586129
  },
  {
   "id": "c6",
   "text": "The RealD projector alternately projects right-eye frames and left-eye frames, switching between them 144 times per second.",
   "sources": [
    "https://en.wikipedia.org/wiki/RealD_3D"
   ],
   "source_revision": 1375938377
  },
  {
   "id": "c7",
   "text": "A ZScreen circularly polarizes the frames clockwise for the right eye and counter-clockwise for the left eye; the audience wears circularly polarized glasses with oppositely polarized lenses so each eye sees only its designated frame.",
   "sources": [
    "https://en.wikipedia.org/wiki/RealD_3D"
   ],
   "source_revision": 1375938377
  },
  {
   "id": "c8",
   "text": "The advantage of circular polarization over linear polarization is that viewers are able to tilt their heads and look about the theater naturally without seeing double or darkened images.",
   "sources": [
    "https://en.wikipedia.org/wiki/RealD_3D"
   ],
   "source_revision": 1375938377
  },
  {
   "id": "c9",
   "text": "Anaglyph 3D overlays images in different colors with corresponding filters for each eye; the colors are most typically red and cyan.",
   "sources": [
    "https://en.wikipedia.org/wiki/Anaglyph_3D"
   ],
   "source_revision": 1377575293
  },
  {
   "id": "c10",
   "text": "Active shutter glasses are controlled by a timing signal that allows the glasses to alternately block one eye, and then the other, in synchronization with the refresh rate of the screen.",
   "sources": [
    "https://en.wikipedia.org/wiki/Active_shutter_3D_system"
   ],
   "source_revision": 1377573408
  }
 ],
